plt.plot(x,y,'black')


from sklearn.svm import SVC


## help(SVC)


X = df.drop('Virus Present',axis=1)


y = df['Virus Present']


model = SVC(kernel='linear',C=1000)


model.fit(X,y)


from svm_margin_plot import plot_svm_boundary


plot_svm_boundary(model=model,X,y)



